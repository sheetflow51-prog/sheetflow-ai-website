# SheetFlow AI — Environment Variables
# Copy to .env.local for local development.
# In production: configure in Vercel → Settings → Environment Variables.
# Never commit .env.local to version control.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site URL (no trailing slash).
# Used by: OG images, sitemap, JSON-LD, canonical tags.
NEXT_PUBLIC_SITE_URL=https://sheetflow.click

# ─────────────────────────────────────────────────────────────────────────────
# PROOF FEATURE FLAGS — all optional, all default to false (section hidden)
# ─────────────────────────────────────────────────────────────────────────────
# These gate every customer-facing claim. A flag may only be set to "true" once
# the matching entries in src/content/proof.ts are status:'verified' AND carry
# written permission from the customer. See src/config/features.ts.
#
# Setting a flag true with no verified entries is safe — the selector returns an
# empty list and the section falls back to its placeholder.
NEXT_PUBLIC_FEATURE_CASE_STUDIES=false
NEXT_PUBLIC_FEATURE_TESTIMONIALS=false
NEXT_PUBLIC_FEATURE_TRUST_LOGOS=false
NEXT_PUBLIC_FEATURE_RESULTS=false

# ─────────────────────────────────────────────────────────────────────────────
# SPLINE 3D SCENES — all optional (empty string = R3F AICore fallback)
# ─────────────────────────────────────────────────────────────────────────────
# URL format: https://prod.spline.design/<id>/scene.splinecode
# Obtain from: Spline → File → Export → Code Export → React
# Staging URLs (spline.design/preview/*) NOT allowed in production env.
# Promotion order: Dashboard → Workflow → Hero → CTA (FINAL_EXECUTION_LAYER §5.3)
NEXT_PUBLIC_SPLINE_SCENE_HERO=
NEXT_PUBLIC_SPLINE_SCENE_WORKFLOW=
NEXT_PUBLIC_SPLINE_SCENE_DASHBOARD=
NEXT_PUBLIC_SPLINE_SCENE_CTA=

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS — all optional, zero-config when packages are installed
# ─────────────────────────────────────────────────────────────────────────────
# Vercel Analytics: enable in Vercel Dashboard → Project → Analytics
# No env var needed — activated by <Analytics /> in layout.tsx.

# Plausible (privacy-first alternative):
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=sheetflow.click

# ─────────────────────────────────────────────────────────────────────────────
# FUTURE — not yet implemented
# ─────────────────────────────────────────────────────────────────────────────
# Inquiry form backend (server-only, never NEXT_PUBLIC_*)
# RESEND_API_KEY=
# INQUIRY_FROM_EMAIL=hello@sheetflow.ai
# INQUIRY_TO_EMAIL=founders@sheetflow.ai

# ─────────────────────────────────────────────────────────────────────────────
# CALENDLY WEBHOOK RELAY — server-only, never NEXT_PUBLIC_* (D45)
# ─────────────────────────────────────────────────────────────────────────────
# POST /api/calendly verifies Calendly's signature and forwards invitee.created
# to the n8n intake SF-I1 with the secret header. Any missing or invalid value
# makes the route answer 503 and forward nothing. Production only; set the real
# values in Vercel, never here.
# CALENDLY_WEBHOOK_SIGNING_KEY=   (the subscription's signing key, 16+ chars)
# SF_INTAKE_URL=                  (https://<tunnel host>/webhook/sf-discovery-intake)
# SF_INTAKE_HEADER_NAME=          (optional, default X-SF-Intake; must match n8n)
# SF_INTAKE_SECRET=               (n8n Header Auth value, 32+ printable ASCII, no spaces)

# ─────────────────────────────────────────────────────────────────────────────
# HYBRID LEAD CAPTURE + CAL.COM WEBHOOKS — server-only, never NEXT_PUBLIC_* (D46)
# ─────────────────────────────────────────────────────────────────────────────
# POST /api/intake captures the /book lead, forwards it to SF-I1, then redirects
# the visitor to the Cal.com booking link with prefill. POST /api/cal-webhook
# verifies Cal.com's signature and relays BOOKING_CREATED / RESCHEDULED /
# CANCELLED to SF-I1. Both reuse the SF_INTAKE_* variables above. Built on a
# branch, not deployed; set the real values in Vercel, never here.
#
# CAL_BOOKING_URL=      (the PUBLIC event link, https://cal.com/<user>/<event>;
#                        not a secret. Missing or invalid: /api/intake falls back
#                        to today's Calendly link.)
# CAL_WEBHOOK_SECRET=   (the secret typed into the Cal.com webhook, 16+ printable
#                        ASCII, no spaces. Missing: /api/cal-webhook answers 503.)
#
# Read by the /api/intake origin check, set by Vercel itself (no action needed):
# VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL, plus
# NEXT_PUBLIC_SITE_URL above.
