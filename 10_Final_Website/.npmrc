# @react-three/drei@9 declares a peer of @react-three/fiber@^8, but this project
# pins fiber ^9. npm 7+ treats that as a hard error, so a plain `npm install`
# exits 1 — which is exactly how Vercel installs, and why deploys fail at the
# install step before any build runs.
#
# Every local install has used --legacy-peer-deps since before M00; this makes
# that resolution explicit and reproducible on CI instead of tribal knowledge.
#
# This is a workaround, not a fix. The three components that need those
# packages (src/components/three/) are imported by no rendered code, and the
# shipped bundle contains zero Three.js symbols — so six dependencies are
# breaking deployment for code that does not run. Removing them retires the
# planned Spline direction, which is a founder decision, tracked as A1 in
# PROJECT_STATUS.md. When A1 is resolved either way, delete this file and
# confirm `npm install` succeeds unaided.
legacy-peer-deps=true
